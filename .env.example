# Salin file ini menjadi `.env` di folder yang sama (apps/api/.env)
# dan isi DATABASE_URL. JANGAN commit file .env (sudah ada di .gitignore).
#
# --- Neon (yang dipakai user) ---
# Buka dashboard Neon → project → Connection Details → pilih
# "Pooled connection" → salin connection string-nya ke sini.
# Contoh bentuknya (ganti user, password, host, dan database):
# DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<database>?sslmode=require
#
# --- PostgreSQL lokal (untuk pengujian di VM ini) ---
# DATABASE_URL=postgresql://carapi:carapi_dev_local@localhost:5432/car_api
DATABASE_URL=

# Batas harian per tier (opsional — default Free 100/hari, Pro 10.000/hari).
# Bila diisi, env ini mengalahkan angka di tabel plans.
# CARAPI_FREE_DAILY_LIMIT=100
# CARAPI_PRO_DAILY_LIMIT=10000

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000