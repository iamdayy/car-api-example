---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "API spesifikasi mobil yang beredar di Indonesia." } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Beranda" },
  { href: "/docs", label: "Dokumentasi" },
  { href: "/playground", label: "Coba API" },
  { href: "/dashboard", label: "Dashboard" },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Car Web API</title>
    <meta name="description" content={description} />
    <style>
      :root {
        --ink: #0f172a;
        --muted: #64748b;
        --line: #e2e8f0;
        --accent: #ea580c;
        --accent-soft: #fff7ed;
        --dark: #0b1220;
        --card: #ffffff;
        --radius: 12px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); background: #f8fafc; line-height: 1.6; }
      a { color: var(--accent); }
      header.top { background: var(--dark); color: #fff; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; }
      .nav { display: flex; align-items: center; gap: 24px; padding: 14px 0; flex-wrap: wrap; }
      .logo { font-weight: 800; font-size: 18px; color: #fff; text-decoration: none; letter-spacing: -0.02em; }
      .logo span { color: var(--accent); }
      .nav a.link { color: #cbd5e1; text-decoration: none; font-size: 14px; }
      .nav a.link:hover, .nav a.link.active { color: #fff; }
      .nav a.link.active { border-bottom: 2px solid var(--accent); padding-bottom: 2px; }
      .nav .spacer { flex: 1; }
      .btn { display: inline-block; background: var(--accent); color: #fff; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 0; cursor: pointer; font-size: 15px; }
      .btn:hover { background: #c2410c; }
      .btn.ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
      .btn.ghost:hover { background: #f1f5f9; }
      main { padding: 36px 0 64px; }
      h1 { font-size: 34px; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 12px; }
      h2 { font-size: 22px; margin: 40px 0 12px; }
      h3 { font-size: 17px; margin: 24px 0 8px; }
      p.lead { font-size: 18px; color: var(--muted); margin: 0 0 24px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; margin: 16px 0; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .muted { color: var(--muted); }
      .small { font-size: 13px; }
      code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 13px; }
      pre { background: var(--dark); color: #e2e8f0; padding: 16px; border-radius: var(--radius); overflow-x: auto; font-size: 13px; line-height: 1.5; }
      pre code { background: transparent; color: inherit; padding: 0; }
      input, select, textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 15px; margin: 4px 0 12px; font-family: inherit; }
      label { font-weight: 600; font-size: 14px; }
      table { border-collapse: collapse; width: 100%; font-size: 14px; }
      th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
      th { background: #f8fafc; }
      .pill { display: inline-block; background: var(--accent-soft); color: #9a3412; font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 999px; }
      .warn { background: #fef9c3; border: 1px solid #fde047; border-radius: 8px; padding: 12px 16px; font-size: 14px; margin: 16px 0; }
      .bar { height: 10px; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
      .bar > div { height: 100%; background: var(--accent); }
      footer { border-top: 1px solid var(--line); padding: 24px 0; color: var(--muted); font-size: 13px; }
      .keybox { font-family: ui-monospace, monospace; word-break: break-all; background: #f1f5f9; padding: 12px; border-radius: 8px; font-size: 14px; }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="wrap nav">
        <a class="logo" href="/">Car<span>API</span></a>
        {nav.map((n) => (
          <a class="link" class:list={[{ active: path === n.href }]} href={n.href}>{n.label}</a>
        ))}
        <div class="spacer"></div>
        <a class="btn" href="/dashboard">Dapatkan API Key</a>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer>
      <div class="wrap">
        Car Web API — contoh prototype untuk klien Projects.co.id. Data spek pada contoh ini
        adalah data contoh dan harus diverifikasi dari situs resmi pabrikan sebelum tayang.
      </div>
    </footer>
  </body>
</html>
