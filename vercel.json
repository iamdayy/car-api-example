{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "hono"
    },
    "portal": {
      "root": "apps/portal",
      "framework": "astro",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "PUBLIC_API_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "portal" } }
  ]
}
